# Run `npm run setup` to fill in everything below interactively — it creates the
# Telegram/Google/spreadsheet values for you. This file is the reference/fallback
# for manual editing.

# ─── Telegram ─────────────────────────────────────────────────────────────────
# 1. Open Telegram and message @BotFather
# 2. Send /newbot, follow the prompts, copy the token it gives you
TELEGRAM_BOT_TOKEN=123456789:AAF_your_bot_token_here

# Your personal Telegram chat ID (numeric). `npm run setup` detects this
# automatically by waiting for your first message to the bot.
TELEGRAM_CHAT_ID=123456789

# ─── Google (Calendar, Gmail, Sheets — one OAuth consent covers all three) ────
# `npm run setup` runs the OAuth flow in your browser and fills in the values
# below automatically, including creating your own private data spreadsheet.
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_CALENDAR_REFRESH_TOKEN=your_refresh_token_here

# Advanced/optional: only set these if you want to use your own Google Cloud
# project instead of the app's shared OAuth client. See README.md for details.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── LLM (open-source models, OpenAI-compatible API) ─────────────────────────
# Works with any OpenAI-compatible endpoint. Examples:
#   Groq (default): LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile   (free key at https://console.groq.com)
#     Check https://console.groq.com/docs/models for current models — Groq retires
#     preview models over time, so pin whichever one has the best free-tier TPM
#     among models that support tool calling (see /docs/rate-limits and /docs/tool-use).
#   OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.2   (no key needed)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here

# ─── News API ────────────────────────────────────────────────────────────────
# Supported providers: "newsapi" or "gnews"
#   newsapi → get a free key at https://newsapi.org/register (free tier: 100 req/day)
#   gnews   → get a free key at https://gnews.io (free tier: 100 req/day)
NEWS_API_PROVIDER=newsapi
NEWS_API_KEY=your_news_api_key_here

# ─── Scheduling ──────────────────────────────────────────────────────────────
# Cron expressions for the two scheduled jobs.
# Timezone must be a valid tz database name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York
MORNING_DIGEST_TIME=0 8 * * *
EVENING_CHECKIN_TIME=0 21 * * *
NIGHTLY_REMINDER_TIME=50 23 * * *

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
